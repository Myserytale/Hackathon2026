# Optional — Docker already uses Mailpit by default (no .env needed).
# Open http://localhost:8025 to read 2FA codes.

# --- Option A: Mailpit (default in docker-compose, zero setup) ---
# SPRING_MAIL_HOST=mailpit
# SPRING_MAIL_PORT=1025
# SPRING_MAIL_SMTP_AUTH=false
# SPRING_MAIL_STARTTLS=false

# --- Option B: Mailtrap (cloud inbox, needs free account at mailtrap.io) ---
# SPRING_MAIL_HOST=sandbox.smtp.mailtrap.io
# SPRING_MAIL_PORT=2525
# SPRING_MAIL_USERNAME=your_mailtrap_username
# SPRING_MAIL_PASSWORD=your_mailtrap_password
# SPRING_MAIL_SMTP_AUTH=true
# SPRING_MAIL_STARTTLS=true

MAIL_FROM=ROeID <noreply@roeid.ro>
